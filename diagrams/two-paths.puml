' Home — the whole argument in one figure. Two routes from the same question to
' very different answers. Accent marks the consequence of each route, so the
' comparison reads before any of the labels do.
@startuml
!include theme.puml
' two horizontal lanes rather than two columns: it fills the 860px measure, and
' reading a comparison across is easier than reading it down
left to right direction

' Declaration order is inverted on purpose. Graphviz stacks the last-declared
' cluster on top, and the problem has to be the lane you read first.
rectangle "<size:11>CONTOUR" as g2 <<frame>> {
  rectangle "The same question" as q2
  rectangle "Assistant calls\ntyped operations" as w2
  rectangle "Governed model\nof your business" as m2
  rectangle "Your source systems" as s2
  rectangle "An answer, and the\nrecords under it." as r2 <<emph>>

  q2 --> w2
  w2 --> m2
  m2 --> s2
  s2 --> r2
  r2 -[#1E40AF,dashed]-> m2 : lineage
}

rectangle "<size:11>POINTING A MODEL AT THE DATABASE" as g1 <<frame>> {
  rectangle "The same question" as q1
  rectangle "Assistant writes\nits own SQL" as w1
  rectangle "Thousands of\nunfamiliar tables" as t1
  rectangle "A plausible number.\nRight most of the time." as r1 <<emph>>

  q1 --> w1
  w1 --> t1
  t1 --> r1
}
@enduml
